# GateWay:Oblivion — backend configuration

# ── NetVision (native sensor fabric) ─────────────────────────────────────
NETVISION_URL=http://localhost:8000
NETVISION_WS_URL=ws://localhost:8000/ws
NETVISION_USERNAME=admin
NETVISION_PASSWORD=change-me

# ── Obsidian vault (server-side notes + JSON Canvas) ─────────────────────
OBSIDIAN_VAULT_PATH=/home/dark00/Obsidian/Vault
# OBSIDIAN_API_KEY=
OBSIDIAN_API_HOST=https://localhost:27124

# ── Scope guardrails (offensive actions outside these CIDRs are rejected) ─
# Comma-separated. Empty = advisory mode (no enforcement).
OBLIVION_SCOPE=

# ── Persistence & audit ──────────────────────────────────────────────────
OBLIVION_DATA_DIR=./data
OBLIVION_PERSISTENCE=true
# OBLIVION_AUDIT_LOG=./data/audit.jsonl

# ── Frontend (place in web/.env.local instead) ───────────────────────────
# NEXT_PUBLIC_API_URL=http://localhost:8001
