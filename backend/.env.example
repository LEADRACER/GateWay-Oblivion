# GateWay:Oblivion — backend configuration

# ── NetVision (native sensor fabric) ─────────────────────────────────────
NETVISION_URL=http://localhost:8000
NETVISION_WS_URL=ws://localhost:8000/ws
NETVISION_USERNAME=admin
NETVISION_PASSWORD=change-me

# ── Obsidian vault (server-side notes + JSON Canvas) ─────────────────────
OBSIDIAN_VAULT_PATH=/home/dark00/Obsidian/Vault
# OBSIDIAN_API_KEY=
OBSIDIAN_API_HOST=https://localhost:27124

# ── Scope guardrails (offensive actions outside these CIDRs are rejected) ─
# Comma-separated. Empty = advisory mode (no enforcement).
OBLIVION_SCOPE=

# ── ProjectDiscovery toolchain (optional local binaries) ─────────────────
# Directory containing subfinder, httpx, katana, nuclei, naabu, dnsx
PROJECTDISCOVERY_BIN_DIR=./tools/bin

# Directory containing sherlock, maigret, theHarvester, amass, spiderfoot
OSINT_BIN_DIR=./tools/bin
# Optional: full path to SpiderFoot's sf.py (CLI with -o json)
# SPIDERFOOT_PATH=

# ── Blue-team telemetry (all optional) ───────────────────────────────────
# Wazuh REST API
# WAZUH_URL=https://localhost:55000
# WAZUH_USER=oblivion
# WAZUH_PASSWORD=
# WAZUH_VERIFY_SSL=false
# Local logs / rules
SURICATA_EVE_PATH=/var/log/suricata/eve.json
ZEEK_LOG_DIR=/var/log/zeek
SIGMA_RULES_DIR=./rules/sigma
YARA_RULES_DIR=./rules/yara
# YARA_BINARY=yara
# Case management / threat intel
# THEHIVE_URL=http://localhost:9000
# THEHIVE_API_KEY=
# MISP_URL=https://localhost
# MISP_API_KEY=

# ── Persistence & audit (embedded SQLite — no remote database) ───────────
OBLIVION_DB_PATH=./data/oblivion.db
OBLIVION_BACKUP_DIR=./data/backups
OBLIVION_DATA_DIR=./data
OBLIVION_PERSISTENCE=true
# OBLIVION_AUDIT_LOG=./data/audit.jsonl

# ── Frontend (place in web/.env.local instead) ───────────────────────────
# NEXT_PUBLIC_API_URL=http://localhost:8001
